<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Cratis.Architecture.CodeAnalysis</AssemblyName>
    <PackageId>Cratis.Architecture.CodeAnalysis</PackageId>
    <Description>Roslyn analyzers enforcing Cratis architecture principles.</Description>
    <IsRoslynAnalyzer>true</IsRoslynAnalyzer>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Remove="System.Text.Json" />
    <PackageReference Remove="Microsoft.SourceLink.GitHub" />
    <PackageReference Remove="Cratis.Fundamentals" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
  </ItemGroup>
</Project>
